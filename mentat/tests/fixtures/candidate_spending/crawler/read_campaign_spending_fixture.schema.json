{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mentat:committee-activity:read_campaign_spending:v1",
  "title": "read_campaign_spending fixture container; $defs/Result is the function return value",
  "description": "Root validates the fixture file (synthetic examples). Validate a real return value against #/$defs/Result. Row-level cross-field facts JSON Schema cannot state: row_occurrences == len(rows); rows are the provider's original Schedule B objects, in page then ordinal order; a partial/pending/not_seeded list is NOT the committee total and never implies zero.",
  "type": "object",
  "required": ["synthetic", "warning", "function", "schema", "examples"],
  "properties": {
    "synthetic": {"const": true},
    "warning": {"type": "string", "minLength": 1},
    "function": {"type": "string"},
    "schema": {"type": "string"},
    "examples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "comment", "call", "result"],
        "additionalProperties": false,
        "properties": {
          "name": {"enum": ["complete", "partial", "pending", "not_seeded", "mapping_unknown"]},
          "comment": {"type": "string"},
          "call": {
            "type": "object",
            "required": ["cycle", "candidate_id", "committee_id"],
            "additionalProperties": false,
            "properties": {
              "cycle": {"type": "integer"},
              "candidate_id": {"type": ["string", "null"]},
              "committee_id": {"type": ["string", "null"]}
            }
          },
          "result": {"$ref": "#/$defs/Result"}
        }
      }
    }
  },
  "$defs": {
    "CommitteeId": {"type": "string", "pattern": "^C[0-9]{8}$"},
    "CandidateId": {"type": "string", "pattern": "^[HSP][A-Z0-9]{8}$"},
    "Iso": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "EndpointStatus": {
      "description": "Ledger vocabulary plus reader-only values: not_seeded (no unit in the snapshot), unknown (no committee to look up), unsupported (family not collected for this unit).",
      "enum": ["complete", "pending", "blocked", "closed_unknown", "inconsistent", "source_refused", "unsupported", "not_seeded", "unknown"]
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "snapshot", "mapping", "committees"],
      "properties": {
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cycle", "candidate_id", "committee_id"],
          "properties": {
            "cycle": {"type": "integer"},
            "candidate_id": {"oneOf": [{"$ref": "#/$defs/CandidateId"}, {"type": "null"}]},
            "committee_id": {"oneOf": [{"$ref": "#/$defs/CommitteeId"}, {"type": "null"}]}
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["batch", "sha256"],
          "properties": {"batch": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        },
        "mapping": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_id", "source", "vintage_or_retrieved_at", "committee_ids"],
              "properties": {
                "candidate_id": {"$ref": "#/$defs/CandidateId"},
                "source": {"type": "string", "minLength": 1},
                "vintage_or_retrieved_at": {"type": ["string", "null"]},
                "committee_ids": {"type": "array", "items": {"$ref": "#/$defs/CommitteeId"}, "minItems": 1}
              }
            }
          ]
        },
        "committees": {"type": "array", "items": {"$ref": "#/$defs/Committee"}}
      }
    },
    "Committee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["committee_id", "committee_name", "cycle", "coverage_status", "endpoint_status", "retrieved_at", "totals", "rows", "row_occurrences", "disclosure_boundaries"],
      "properties": {
        "committee_id": {"oneOf": [{"$ref": "#/$defs/CommitteeId"}, {"type": "null"}], "description": "null only for mapping_unknown."},
        "committee_name": {"type": ["string", "null"]},
        "cycle": {"type": "integer"},
        "coverage_status": {"enum": ["complete", "partial", "pending", "not_seeded", "mapping_unknown"]},
        "endpoint_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["B", "totals"],
          "properties": {"B": {"$ref": "#/$defs/EndpointStatus"}, "totals": {"$ref": "#/$defs/EndpointStatus"}}
        },
        "retrieved_at": {
          "type": "object",
          "additionalProperties": false,
          "required": ["B_latest", "totals"],
          "properties": {"B_latest": {"oneOf": [{"$ref": "#/$defs/Iso"}, {"type": "null"}]}, "totals": {"oneOf": [{"$ref": "#/$defs/Iso"}, {"type": "null"}]}}
        },
        "totals": {"type": "array", "items": {"type": "object"}, "description": "Raw /committee/{id}/totals/ result objects (UNPINNED shape: no field is guaranteed)."},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/ScheduleBRow"}, "description": "Original archived Schedule B objects, every occurrence, unmodified."},
        "row_occurrences": {"type": "integer", "minimum": 0},
        "disclosure_boundaries": {"type": "integer", "minimum": 0, "description": "Count of B rows with no verified paid-counterparty committee ID (payee disclosure boundary); not proof of no onward spending."}
      },
      "allOf": [
        {"if": {"properties": {"coverage_status": {"const": "complete"}}, "required": ["coverage_status"]},
         "then": {"properties": {"endpoint_status": {"properties": {"B": {"const": "complete"}, "totals": {"const": "complete"}}},
                                  "retrieved_at": {"properties": {"totals": {"type": "string"}}},
                                  "committee_id": {"type": "string"}}}},
        {"if": {"properties": {"coverage_status": {"enum": ["not_seeded", "mapping_unknown"]}}, "required": ["coverage_status"]},
         "then": {"properties": {"rows": {"maxItems": 0}, "totals": {"maxItems": 0}, "row_occurrences": {"const": 0}, "disclosure_boundaries": {"const": 0},
                                  "retrieved_at": {"properties": {"B_latest": {"type": "null"}, "totals": {"type": "null"}}}}}},
        {"if": {"properties": {"coverage_status": {"const": "mapping_unknown"}}, "required": ["coverage_status"]},
         "then": {"properties": {"committee_id": {"type": "null"}}}},
        {"if": {"properties": {"coverage_status": {"const": "pending"}}, "required": ["coverage_status"]},
         "then": {"properties": {"rows": {"maxItems": 0}, "totals": {"maxItems": 0}}}}
      ]
    },
    "ScheduleBRow": {
      "type": "object",
      "description": "OpenFEC /schedules/schedule_b/ row. Only the keys the ledger itself relies on are required; every other provider key is passed through untouched.",
      "required": ["sub_id", "committee_id", "disbursement_amount"],
      "properties": {
        "sub_id": {"type": ["string", "integer"]},
        "committee_id": {"type": "string"},
        "committee": {"type": ["object", "null"]},
        "disbursement_amount": {"type": ["number", "null"]},
        "disbursement_date": {"type": ["string", "null"]},
        "disbursement_description": {"type": ["string", "null"]},
        "disbursement_purpose_category": {"type": ["string", "null"]},
        "recipient_name": {"type": ["string", "null"]},
        "recipient_committee_id": {"type": ["string", "null"]},
        "recipient_committee": {"type": ["object", "null"]},
        "two_year_transaction_period": {"type": ["integer", "null"]},
        "memoed_subtotal": {"type": ["boolean", "null"]},
        "report_type": {"type": ["string", "null"]},
        "report_year": {"type": ["string", "integer", "null"]},
        "line_number": {"type": ["string", "null"]},
        "transaction_id": {"type": ["string", "null"]},
        "pdf_url": {"type": ["string", "null"]}
      }
    }
  }
}
