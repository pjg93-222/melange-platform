{
 "name": "arrival_gates_cases",
 "version": 1,
 "rule": "F12 earliest arrival with one-cycle carryover (Paul approved 2026-09-25, carryover option (b)). gate(root) is its cycle window's first day and all of a root's activity counts; a transfer X->Y dated t opens Y only if t >= gate(X) and X's counted transfers to Y net above zero, and gate(Y) is the earliest such t; a committee's spending counts only on or after its gate; an undated row counts, flagged date_unverified. Carryover: a committee first reached during cycle C-1 (walking from the root's gate at C-1's first day) opens in cycle C at C's first day (gate_source carryover); one first reached during C keeps its arrival date (in-cycle); only cycle-C rows are counted; one cycle back only; 'onward' follows time-respecting C-1 transfers beyond the root, 'direct' only the root's own C-1 recipients; when the root's C-1 unit is not saved the carryover is unknown and the in-cycle rule stands alone.",
 "format": {
  "units": "every saved committee/cycle; a committee/cycle not listed is not saved",
  "transfers": "committee-to-committee cash transfers (24G) the unit made: to, date (YYYY-MM-DD or empty), amount",
  "spending": "the unit's independent expenditures supporting a candidate: date, amount",
  "expect.gates": "cycle|committee -> [gate date, gate_source]; roots, carryover and in-cycle",
  "expect.not_reached": "cycle|committee keys that must not be in the network",
  "expect.counted_spending": "cycle|committee -> the spending counted downstream of the root",
  "expect.carryover_status": "known, partial, unknown or off",
  "expect.missing_units": "cycle|committee previous-cycle units the carryover walk needed and could not read"
 },
