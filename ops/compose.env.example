# /srv/serve/compose.env: operator values for ops/compose.yaml.
#
# Every PASTE value is entered by Paul (ops/VPS.md has the step-by-step). melange_update.py
# refuses to deploy while any PASTE placeholder remains. It keeps every line below untouched and
# only rewrites the managed block at the very bottom (IMAGE_* for the three systems, RELEASE_ID).
# Secrets do not belong here: the tunnel token and the Terrier secret keys live in
# /srv/serve/secrets/*.env (root-only).

# Apex domain on Cloudflare; hosts are melange.<DOMAIN>, mentat., co05., or05., ct01., ssh.
DOMAIN=PASTE-YOUR-DOMAIN.invalid

# Zero Trust team name: JWTs are issued by https://<TEAM>.cloudflareaccess.com
TEAM=PASTE-TEAM-NAME

# One Access application per host; the AUD tag is on the application's Overview page.
AUD_MELANGE=PASTE-AUD-MELANGE
AUD_MENTAT=PASTE-AUD-MENTAT
AUD_CO05=PASTE-AUD-CO05
AUD_OR05=PASTE-AUD-OR05
AUD_CT01=PASTE-AUD-CT01

# Comma-separated service-token common names the apps accept without an email
# (svc-status for `release status`). Leave empty to accept none.
ACCESS_SERVICE_CNS=

# cloudflared 2026.10.0 by index digest: the value in ops/images.lock (a test keeps them equal).
IMAGE_CLOUDFLARED=cloudflare/cloudflared@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07
