{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:employment-adjudication-independent-verification:v1",
  "title": "Independent verification receipt for an employment adjudication twin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "method_version", "status", "assertions", "failures",
    "decision_failure_counts", "episode_failure_counts", "summary_failure_counts",
    "sample_failure_counts", "token_negative_scan_matches",
    "primary_receipt_sha256", "twin_receipt_sha256"
  ],
  "properties": {
    "schema_id": {"const": "staffer-network-employment-adjudication-independent-verification-v1"},
    "method_version": {"const": "bulk-employment-adjudication-independent-verifier-v2"},
    "status": {"enum": ["PASS", "FAIL"]},
    "assertions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decision_failure_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "episode_failure_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "summary_failure_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "sample_failure_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "token_negative_scan_matches": {"type": "integer", "minimum": 0},
    "primary_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "twin_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
