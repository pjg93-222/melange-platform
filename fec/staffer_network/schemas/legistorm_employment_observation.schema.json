{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:legistorm-employment-observation:v1",
  "title": "Restricted normalized LegiStorm employment observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "observation_id", "source_system_id", "profile_id",
    "profile_url", "retrieved_at", "source_as_of", "profile_title_raw",
    "lda_source_person_id", "source_row_id", "raw_person_name", "raw_employer",
    "raw_title", "raw_start", "normalized_start", "raw_end", "normalized_end",
    "start_precision", "end_precision", "source_end_semantics",
    "asserted_current", "person_subject_id", "employment_key",
    "container_subject_id", "start_earliest", "start_latest", "end_earliest",
    "end_latest", "source_record_sha256"
  ],
  "properties": {
    "schema_id": {"const": "staffer-network-legistorm-employment-observation-v1"},
    "observation_id": {"type": "string", "pattern": "^legistorm:employment-observation:[0-9a-f]{64}$"},
    "source_system_id": {"const": "legistorm"},
    "profile_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "profile_url": {"type": "string", "format": "uri"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "source_as_of": {"type": "string", "format": "date"},
    "profile_title_raw": {"type": "string", "minLength": 1},
    "lda_source_person_id": {"type": ["string", "null"]},
    "source_row_id": {"type": "string", "minLength": 1},
    "raw_person_name": {"type": "string", "minLength": 1},
    "raw_employer": {"type": "string", "minLength": 1},
    "raw_title": {"type": ["string", "null"]},
    "raw_start": {"type": ["string", "null"]},
    "normalized_start": {"type": ["string", "null"]},
    "raw_end": {"type": ["string", "null"]},
    "normalized_end": {"type": ["string", "null"]},
    "start_precision": {"enum": ["day", "month", "year", "unknown"]},
    "end_precision": {"enum": ["day", "month", "year", "unknown"]},
    "source_end_semantics": {"enum": ["inclusive", "exclusive", "current", "unknown"]},
    "asserted_current": {"type": "boolean"},
    "person_subject_id": {"type": "string", "pattern": "^legistorm:person:[1-9][0-9]*$"},
    "employment_key": {"type": "string", "pattern": "^legistorm:employment-key:[0-9a-f]{64}$"},
    "container_subject_id": {"type": "string", "pattern": "^legistorm:container-candidate:[0-9a-f]{64}$"},
    "start_earliest": {"type": ["string", "null"], "format": "date"},
    "start_latest": {"type": ["string", "null"], "format": "date"},
    "end_earliest": {"type": ["string", "null"], "format": "date"},
    "end_latest": {"type": ["string", "null"], "format": "date"},
    "source_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
