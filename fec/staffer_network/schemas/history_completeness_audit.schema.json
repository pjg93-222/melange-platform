{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:employment-completeness-audit:v2",
  "title": "Employment-first history completeness audit row",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "COMPLETE"}}
      },
      "then": {
        "properties": {
          "employment_status": {"const": "COMPLETE"},
          "failure_codes": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "employment_status": {"const": "INCOMPLETE"},
          "failure_codes": {"minItems": 1}
        }
      }
    }
  ],
  "required": [
    "schema_id",
    "lda_source_person_id",
    "display_name",
    "status",
    "employment_status",
    "education_status",
    "binding_completeness_dimension",
    "employment_episode_count",
    "education_episode_count",
    "failure_codes",
    "education_diagnostic_codes"
  ],
  "properties": {
    "schema_id": {
      "const": "staffer-network-employment-completeness-audit-v2"
    },
    "lda_source_person_id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {},
    "status": {
      "enum": ["COMPLETE", "INCOMPLETE"]
    },
    "employment_status": {
      "enum": ["COMPLETE", "INCOMPLETE"]
    },
    "education_status": {
      "enum": ["COMPLETE", "PARTIAL", "MISSING"]
    },
    "binding_completeness_dimension": {
      "const": "EMPLOYMENT"
    },
    "employment_episode_count": {
      "type": "integer",
      "minimum": 0
    },
    "education_episode_count": {
      "type": "integer",
      "minimum": 0
    },
    "failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "education_diagnostic_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
