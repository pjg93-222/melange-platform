{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:politico-crawl-receipt:v1",
  "title": "Politico Pro directory crawl receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "generated_at", "status", "source_census", "observed_rows",
    "unique_profile_uuids", "duplicate_uuid_occurrences", "partition_expected",
    "partition_observed", "pages_expected", "pages_observed", "request_failures",
    "max_requests_in_any_rolling_minute", "max_in_flight_requests",
    "request_duration_p95_ms", "role_assertions",
    "rows_with_issue_areas", "prohibited_contact_keys",
    "rows_matching_email_or_phone_patterns", "retained_fields", "rows_sha256",
    "request_log_sha256", "partition_inventory_sha256", "failures"
  ],
  "properties": {
    "schema_id": {"const": "politico-directory-crawl-receipt-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS", "FAIL"]},
    "source_census": {"type": "integer", "minimum": 1},
    "observed_rows": {"type": "integer", "minimum": 0},
    "unique_profile_uuids": {"type": "integer", "minimum": 0},
    "duplicate_uuid_occurrences": {"type": "integer", "minimum": 0},
    "partition_expected": {
      "type": "object", "additionalProperties": false,
      "required": ["Democratic", "Republican", "Unknown", "Independent"],
      "properties": {
        "Democratic": {"type": "integer", "minimum": 0},
        "Republican": {"type": "integer", "minimum": 0},
        "Unknown": {"type": "integer", "minimum": 0},
        "Independent": {"type": "integer", "minimum": 0}
      }
    },
    "partition_observed": {
      "type": "object", "additionalProperties": false,
      "required": ["Democratic", "Republican", "Unknown", "Independent"],
      "properties": {
        "Democratic": {"type": "integer", "minimum": 0},
        "Republican": {"type": "integer", "minimum": 0},
        "Unknown": {"type": "integer", "minimum": 0},
        "Independent": {"type": "integer", "minimum": 0}
      }
    },
    "pages_expected": {"type": "integer", "minimum": 1},
    "pages_observed": {"type": "integer", "minimum": 0},
    "request_failures": {"type": "integer", "minimum": 0},
    "max_requests_in_any_rolling_minute": {"type": "integer", "minimum": 0},
    "max_in_flight_requests": {"type": "integer", "minimum": 0, "maximum": 4},
    "request_duration_p95_ms": {"type": "integer", "minimum": 0},
    "role_assertions": {"type": "integer", "minimum": 0},
    "rows_with_issue_areas": {"type": "integer", "minimum": 0},
    "prohibited_contact_keys": {"type": "array", "items": {"type": "string"}},
    "rows_matching_email_or_phone_patterns": {"type": "integer", "minimum": 0},
    "retained_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rows_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "partition_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "failures": {"type": "array", "items": {"type": "string"}}
  }
}
