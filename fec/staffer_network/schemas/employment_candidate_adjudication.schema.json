{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:employment-candidate-adjudication:v1",
  "title": "Quarantined employment candidate adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "decision_id", "lane", "candidate_id", "lda_source_person_id",
    "display_name", "decision", "reviewer_kind", "reviewer_id", "rationale_codes",
    "evidence_digest", "source_urls", "proposed_episode_id", "method_version",
    "decision_payload_sha256", "canonical_eligible", "canonical_employment_promoted",
    "complete_lifetime_employment_asserted"
  ],
  "properties": {
    "schema_id": {"const": "staffer-network-employment-candidate-adjudication-v1"},
    "decision_id": {"type": "string", "pattern": "^adjudication:decision:[0-9a-f]{64}$"},
    "lane": {"enum": ["bulk_education_line", "bulk_employment_line", "house_payroll_corroborated", "lda_covered_position_parse", "lda_registrant_association", "legilist_source_binding", "senate_payroll_corroborated", "structured_public_profile_episode"]},
    "candidate_id": {"type": "string", "minLength": 1},
    "lda_source_person_id": {"type": "string", "pattern": "^lda:lobbyist:[0-9]+$"},
    "display_name": {"type": ["string", "null"]},
    "decision": {"enum": ["PROVISIONALLY_ACCEPTED", "ACCEPTED_SOURCE_BINDING", "ACCEPTED_SOURCE_NATIVE_ASSOCIATION", "REJECTED", "REVIEW_REQUIRED"]},
    "reviewer_kind": {"const": "RULE"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "rationale_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "proposed_episode_id": {"type": ["string", "null"]},
    "method_version": {"const": "bulk-employment-adjudication-overlay-v2"},
    "decision_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_eligible": {"const": false},
    "canonical_employment_promoted": {"const": false},
    "complete_lifetime_employment_asserted": {"const": false}
  }
}
