{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:network-build-receipt:v1",
  "title": "Staffer network build receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "generated_at", "status", "network_version", "canonical_receipt_sha256", "nodes", "edges", "primary_evidence_edges", "primary_scoring_edges", "exploratory_scoring_edges", "duplicate_support_edges_excluded_primary", "primary_isolates", "exploratory_isolates", "layers", "identity_candidate_edges_included", "identity_candidate_policy", "primary_scores_exclude_identity_candidates", "canonical_identity_merges", "edge_weight_formula", "scoring_directionality", "temporal_policy", "eigenvector_semantics", "eigenvector_convergence", "eigenvector_nulls_by_entity_kind", "connectedness_semantics", "exploratory_connectedness_semantics", "exploratory_connectedness_convergence", "pagerank_sensitivity", "within_kind_connectedness_semantics", "bridging_semantics", "composite_influence_score", "files", "failures"],
  "properties": {
    "schema_id": {"const": "staffer-network-network-build-receipt-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "PASS"},
    "network_version": {"const": "typed-layer-balanced-deduplicated-contact-minimized-structural-v6"},
    "canonical_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nodes": {"type": "integer", "minimum": 1},
    "edges": {"type": "integer", "minimum": 1},
    "primary_evidence_edges": {"type": "integer", "minimum": 1},
    "primary_scoring_edges": {"type": "integer", "minimum": 1},
    "exploratory_scoring_edges": {"type": "integer", "minimum": 1},
    "duplicate_support_edges_excluded_primary": {"type": "integer", "minimum": 0},
    "primary_isolates": {"type": "integer", "minimum": 0},
    "exploratory_isolates": {"type": "integer", "minimum": 0},
    "layers": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
    "identity_candidate_edges_included": {"type": "integer", "minimum": 0},
    "identity_candidate_policy": {"enum": ["UNAMBIGUOUS_REVIEW_CANDIDATES_EXPLORATORY_LAYER", "EXCLUDED"]},
    "primary_scores_exclude_identity_candidates": {"const": true},
    "canonical_identity_merges": {"const": 0},
    "edge_weight_formula": {"type": "string", "minLength": 1},
    "scoring_directionality": {"type": "string", "minLength": 1},
    "temporal_policy": {"type": "string", "minLength": 1},
    "eigenvector_semantics": {"type": "string", "minLength": 1},
    "eigenvector_convergence": {"type": "object"},
    "eigenvector_nulls_by_entity_kind": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "connectedness_semantics": {"type": "string", "minLength": 1},
    "exploratory_connectedness_semantics": {"type": "string", "minLength": 1},
    "exploratory_connectedness_convergence": {"type": "object"},
    "pagerank_sensitivity": {"type": "object"},
    "within_kind_connectedness_semantics": {"type": "string", "minLength": 1},
    "bridging_semantics": {"type": "string", "minLength": 1},
    "composite_influence_score": {"type": "null"},
    "files": {"type": "array", "minItems": 2, "maxItems": 2},
    "failures": {"type": "array", "maxItems": 0}
  }
}
