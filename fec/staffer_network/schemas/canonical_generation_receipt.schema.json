{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:canonical-generation-receipt:v1",
  "title": "Canonical fact generation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "generated_at", "status", "canonicalization_version", "input_receipts", "analysis_authority_manifest_sha256", "source_activation", "entity_counts", "entity_source_counts", "fact_counts", "fact_source_counts", "excluded_self_loop_facts", "excluded_self_loop_fact_counts", "contact_redaction_counts", "contact_only_facts_excluded", "contact_only_fact_exclusion_counts", "empty_literal_facts_excluded", "empty_literal_fact_exclusion_counts", "undated_nonzero_temporal_weights", "member_link_counts", "identity_link_counts", "canonical_entity_merges", "cross_source_memberships", "identity_candidates_are_facts", "canonical_facts_materialized", "internal_analysis_enabled", "raw_redistribution_claimed", "files", "failures"],
  "properties": {
    "schema_id": {"const": "staffer-network-canonical-generation-receipt-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "PASS"},
    "canonicalization_version": {"const": "source-native-singleton-v6"},
    "input_receipts": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "analysis_authority_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_activation": {"type": "object", "minProperties": 5, "additionalProperties": {"enum": ["ENABLED_INTERNAL_ANALYSIS", "DISABLED_INTERNAL_ANALYSIS"]}},
    "entity_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "entity_source_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "fact_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "fact_source_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "excluded_self_loop_facts": {"type": "integer", "minimum": 0},
    "excluded_self_loop_fact_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "contact_redaction_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "contact_only_facts_excluded": {"type": "integer", "minimum": 0},
    "contact_only_fact_exclusion_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "empty_literal_facts_excluded": {"type": "integer", "minimum": 0},
    "empty_literal_fact_exclusion_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "undated_nonzero_temporal_weights": {"const": 0},
    "member_link_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "identity_link_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "canonical_entity_merges": {"const": 0},
    "cross_source_memberships": {"const": 0},
    "identity_candidates_are_facts": {"const": false},
    "canonical_facts_materialized": {"const": true},
    "internal_analysis_enabled": {"type": "boolean"},
    "raw_redistribution_claimed": {"type": "boolean"},
    "files": {"type": "array", "minItems": 3, "maxItems": 3},
    "failures": {"type": "array", "maxItems": 0}
  }
}
