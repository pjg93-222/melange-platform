{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:lda-industry-edge:v1",
  "title": "Restricted source-native LDA filing-participation edge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "edge_id", "predicate", "subject_id", "subject_kind", "object_id", "object_kind", "raw_weight", "precision_bucket", "support_count", "support_digest"],
  "properties": {
    "schema_id": {"const": "staffer-network-lda-industry-edge-v1"},
    "edge_id": {"type": "string", "pattern": "^lda:edge:[0-9a-f]{64}$"},
    "predicate": {"enum": ["NAMED_ON_ACTIVITY", "FILED_BY", "FOR_CLIENT"]},
    "subject_id": {"type": "string", "pattern": "^lda:(lobbyist|activity):"},
    "subject_kind": {"enum": ["person", "lda_activity"]},
    "object_id": {"type": "string", "pattern": "^lda:(activity|registrant|client):"},
    "object_kind": {"enum": ["lda_activity", "registrant", "client"]},
    "raw_weight": {"type": "number", "const": 1.0},
    "precision_bucket": {"type": "string", "const": "day"},
    "support_count": {"type": "integer", "const": 1},
    "support_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
