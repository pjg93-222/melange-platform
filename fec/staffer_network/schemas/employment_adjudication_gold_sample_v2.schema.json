{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:employment-adjudication-gold-sample:v2",
  "title": "Immutable content-bound unlabeled adjudication calibration sample unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "sample_id", "sample_kind", "partition", "stratum_id",
    "selection_seed_sha256", "candidate_id", "decision_id", "lane",
    "lda_source_person_id", "display_name", "proposed_decision", "rationale_codes",
    "source_urls", "evidence_digest", "decision_payload_sha256",
    "candidate_evidence", "candidate_evidence_sha256", "proposed_episode",
    "proposed_episode_sha256"
  ],
  "properties": {
    "schema_id": {"const": "staffer-network-employment-adjudication-gold-sample-v2"},
    "sample_id": {"type": "string", "pattern": "^adjudication:gold-sample:[0-9a-f]{64}$"},
    "sample_kind": {"enum": ["COVERED_POSITION_PARSER", "IDENTITY_RULE"]},
    "partition": {"const": "CALIBRATION"},
    "stratum_id": {"type": "string", "minLength": 1},
    "selection_seed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "pattern": "^adjudication:decision:[0-9a-f]{64}$"},
    "lane": {"type": "string", "minLength": 1},
    "lda_source_person_id": {"type": "string", "pattern": "^lda:lobbyist:[0-9]+$"},
    "display_name": {"type": ["string", "null"]},
    "proposed_decision": {"enum": ["PROVISIONALLY_ACCEPTED", "REJECTED", "REVIEW_REQUIRED"]},
    "rationale_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_evidence": {"type": "object"},
    "candidate_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposed_episode": {"type": ["object", "null"]},
    "proposed_episode_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
