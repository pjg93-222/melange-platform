{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:littlesis-profile-receipt:v1",
  "title": "LittleSis paired bulk profile receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "generated_at", "status", "source_system_id", "license",
    "terms_uri", "terms_checked_at", "collected_at", "pairing_basis", "files",
    "relationship_prior_sha256", "relationship_matches_prior_dump",
    "entity_observed", "entity_accepted", "entity_invalid", "entity_duplicates",
    "relationship_observed", "relationship_accepted", "relationship_rejected",
    "relationship_invalid", "relationship_duplicates",
    "relationship_dangling_rejected", "accepted_dangling_relationships",
    "category_observed", "category_accepted", "undated_position_accepted",
    "raw_storage", "source_native_ready", "source_enabled",
    "canonical_entity_merges", "share_alike_publication_review_deferred", "failures"
  ],
  "properties": {
    "schema_id": {"const": "staffer-network-littlesis-profile-receipt-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS", "QUARANTINED"]},
    "source_system_id": {"const": "littlesis-bulk"},
    "license": {"const": "Creative Commons Attribution-ShareAlike"},
    "terms_uri": {"type": "string", "format": "uri"},
    "terms_checked_at": {"type": "string", "format": "date-time"},
    "collected_at": {"type": "string", "format": "date-time"},
    "pairing_basis": {"type": "string", "minLength": 1},
    "files": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "sha256", "bytes"],
        "properties": {
          "role": {"enum": ["entities", "relationships"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "relationship_prior_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relationship_matches_prior_dump": {"type": "boolean"},
    "entity_observed": {"type": "integer", "minimum": 1},
    "entity_accepted": {"type": "integer", "minimum": 0},
    "entity_invalid": {"type": "integer", "minimum": 0},
    "entity_duplicates": {"type": "integer", "minimum": 0},
    "relationship_observed": {"type": "integer", "minimum": 1},
    "relationship_accepted": {"type": "integer", "minimum": 0},
    "relationship_rejected": {"type": "integer", "minimum": 0},
    "relationship_invalid": {"type": "integer", "minimum": 0},
    "relationship_duplicates": {"type": "integer", "minimum": 0},
    "relationship_dangling_rejected": {"type": "integer", "minimum": 0},
    "accepted_dangling_relationships": {"const": 0},
    "category_observed": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "category_accepted": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "undated_position_accepted": {"type": "integer", "minimum": 0},
    "raw_storage": {"const": "restricted-machine-local"},
    "source_native_ready": {"type": "boolean"},
    "source_enabled": {"const": false},
    "canonical_entity_merges": {"const": 0},
    "share_alike_publication_review_deferred": {"const": true},
    "failures": {"type": "array", "items": {"type": "string"}}
  }
}
