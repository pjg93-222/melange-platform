{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:employment-adjudication-receipt:v1",
  "title": "Deterministic quarantined employment adjudication generation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "status", "method_version", "as_of", "sealed_scope_people",
    "source_native_identity_acceptances", "cross_source_identity_merges",
    "decision_rows", "decision_status_counts", "lane_status_counts",
    "provisional_episode_rows", "provisional_support_decision_rows",
    "exact_fact_duplicate_rows_collapsed", "provisional_episode_lane_counts",
    "temporal_semantics_counts", "person_summary_rows", "bulk_candidate_rows_conserved",
    "covered_position_rows_conserved", "registrant_association_rows_conserved",
    "structured_profile_rows", "house_payroll_rows_conserved",
    "senate_payroll_rows_conserved", "gold_samples", "canonical_employment_promotions",
    "complete_lifetime_employment_assertions", "primary_temporal_eligible_episodes",
    "open_gates", "gate_states", "inputs", "files", "schemas"
  ],
  "properties": {
    "schema_id": {"const": "staffer-network-employment-adjudication-receipt-v1"},
    "status": {"const": "GENERATION_VALID_REVIEW_OPEN"},
    "method_version": {"const": "bulk-employment-adjudication-overlay-v2"},
    "as_of": {"type": "string", "format": "date"},
    "sealed_scope_people": {"const": 25340},
    "source_native_identity_acceptances": {"const": 25340},
    "cross_source_identity_merges": {"const": 0},
    "decision_rows": {"type": "integer", "minimum": 1},
    "decision_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "lane_status_counts": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}},
    "provisional_episode_rows": {"type": "integer", "minimum": 0},
    "provisional_support_decision_rows": {"type": "integer", "minimum": 0},
    "exact_fact_duplicate_rows_collapsed": {"type": "integer", "minimum": 0},
    "provisional_episode_lane_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "temporal_semantics_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "person_summary_rows": {"const": 25340},
    "bulk_candidate_rows_conserved": {"type": "integer", "minimum": 0},
    "covered_position_rows_conserved": {"type": "integer", "minimum": 0},
    "registrant_association_rows_conserved": {"type": "integer", "minimum": 0},
    "structured_profile_rows": {"type": "integer", "minimum": 0},
    "house_payroll_rows_conserved": {"type": "integer", "minimum": 0},
    "senate_payroll_rows_conserved": {"type": "integer", "minimum": 0},
    "gold_samples": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "canonical_employment_promotions": {"const": 0},
    "complete_lifetime_employment_assertions": {"const": 0},
    "primary_temporal_eligible_episodes": {"const": 0},
    "open_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gate_states": {"type": "object", "additionalProperties": {"const": "OPEN"}},
    "inputs": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "files": {"type": "array", "minItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "records", "bytes", "sha256", "schema_id", "schema_sha256", "privacy_class", "encoding"], "properties": {"role": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "records": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "schema_id": {"type": "string", "minLength": 1}, "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "privacy_class": {"const": "restricted-local"}, "encoding": {"type": "string", "minLength": 1}}}},
    "schemas": {"type": "array", "minItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["schema_id", "path", "sha256"], "properties": {"schema_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
