{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:source-native-corpus-validation-receipt:v1",
  "title": "Full local source-native corpus row-validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "generated_at", "status", "corpus_receipt_sha256", "files",
    "total_records_validated", "all_schema_validation_pass",
    "all_semantic_validation_pass", "failures"
  ],
  "properties": {
    "schema_id": {"const": "staffer-network-source-native-corpus-validation-receipt-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS", "FAIL"]},
    "corpus_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "role", "records_validated", "sha256", "bytes",
          "schema_validation_pass", "semantic_validation_pass"
        ],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "records_validated": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "schema_validation_pass": {"type": "boolean"},
          "semantic_validation_pass": {"type": "boolean"}
        }
      }
    },
    "total_records_validated": {"type": "integer", "minimum": 1},
    "all_schema_validation_pass": {"type": "boolean"},
    "all_semantic_validation_pass": {"type": "boolean"},
    "failures": {"type": "array", "items": {"type": "string"}}
  }
}
