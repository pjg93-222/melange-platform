{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:generation-manifest:v1",
  "title": "Staffer network immutable generation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "generation_id", "build_as_of", "derivation_version",
    "source_manifests", "files"
  ],
  "properties": {
    "schema_id": {"const": "staffer-network-generation-manifest-v1"},
    "generation_id": {"type": "string", "minLength": 1},
    "build_as_of": {"type": "string", "format": "date-time"},
    "derivation_version": {"type": "string", "minLength": 1},
    "source_manifests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["locator", "source_system_id", "manifest_sha256"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "source_system_id": {"type": "string", "minLength": 1},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "schema_id", "schema_sha256", "sha256", "bytes", "records", "privacy_class"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/\\\\]+$"},
          "schema_id": {"type": "string", "minLength": 1},
          "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "records": {"type": "integer", "minimum": 0},
          "privacy_class": {"enum": ["public-safe-derived"]}
        }
      }
    }
  }
}
