{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melange:staffer-network:canonical-entity:v1",
  "title": "Singleton canonical entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "canonical_entity_id", "entity_kind", "display_name", "canonicalization_basis", "source_memberships", "attributes"],
  "properties": {
    "schema_id": {"const": "staffer-network-canonical-entity-v1"},
    "canonical_entity_id": {"type": "string", "pattern": "^canonical:[a-z_]+:[0-9a-f]{64}$"},
    "entity_kind": {"enum": ["person", "legislator", "organization", "legislative_office", "lda_activity", "source_entity"]},
    "display_name": {"type": ["string", "null"]},
    "canonicalization_basis": {"const": "SOURCE_NATIVE_SINGLETON"},
    "source_memberships": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_system_id", "source_entity_id", "source_support_digest"],
        "properties": {
          "source_system_id": {"type": "string", "minLength": 1},
          "source_entity_id": {"type": "string", "minLength": 1},
          "source_support_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "attributes": {"type": "object"}
  }
}
