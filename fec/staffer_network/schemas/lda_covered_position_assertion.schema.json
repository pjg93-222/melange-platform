{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:melange:staffer-network:lda-covered-position-assertion:v1","title":"LDA covered-position source assertion","type":"object","additionalProperties":false,
  "required":["schema_id","source_system_id","assertion_id","source_person_id","source_activity_id","filing_uuid","dt_posted","covered_position","government_term_hits","support_digest"],
  "properties":{
    "schema_id":{"const":"staffer-network-lda-covered-position-assertion-v1"},"source_system_id":{"const":"senate-lda-api"},"assertion_id":{"type":"string","pattern":"^lda:covered-position:[0-9a-f]{64}$"},"source_person_id":{"type":"string","pattern":"^lda:lobbyist:[1-9][0-9]*$"},"source_activity_id":{"type":"string","pattern":"^lda:activity:.+:[0-9]+$"},"filing_uuid":{"type":"string","minLength":1},"dt_posted":{"type":"string","format":"date-time"},"covered_position":{"type":"string","minLength":1},"government_term_hits":{"type":"array","uniqueItems":true,"description":"Unadjudicated lexical substring hits in source text only; not verified government employment.","items":{"enum":["CONGRESS","CONGRESSIONAL","SENATE","SENATOR","HOUSE","REPRESENTATIVE","LEGISLATIVE","COMMITTEE","WHITE HOUSE","EXECUTIVE OFFICE","FEDERAL","GOVERNMENT"]}},"support_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
